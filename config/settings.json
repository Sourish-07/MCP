{
  "models": {
    "decision": "claude-sonnet-5",
    "cheap": "claude-haiku-4-5"
  },
  "trading": {
    "max_positions": 12,
    "max_position_pct": 0.08,
    "edge_score_threshold": 3.0,
    "stop_loss_pct": -0.07,
    "profit_review_pct": 0.15,
    "max_holding_days": 15,
    "portfolio_size": 2000,
    "dry_run": false
  },
  "schedule": {
    "open_hour": 9,
    "open_minute": 35,
    "mid_hour": 12,
    "mid_minute": 30,
    "close_hour": 15,
    "close_minute": 30,
    "timezone": "America/New_York"
  },
  "watchlist": {
    "default_tickers": [
      "JPM",
      "NVDA",
      "AVGO",
      "CAT",
      "MU",
      "TSM",
      "UNH",
      "XOM",
      "AMD",
      "COST"
    ],
    "robinhood_watchlist_name": "Default"
  },
  "cost_limits": {
    "daily_usd_limit": 3.00,
    "monthly_usd_limit": 50.00
  },
  "news": {
    "provider": "finnhub",
    "lookback_days": 3,
    "max_per_ticker": 5,
    "fresh_window_hours": 24,
    "general_market": {
      "enabled": true,
      "category": "general",
      "count": 8
    },
    "haiku_summary": {
      "enabled": false,
      "fetch_cap": 20,
      "max_summary_sentences": 5
    },
    "haiku_fallback": {
      "enabled": false,
      "trigger_when_no_news": true
    }
  },
  "sentiment_selection": {
    "enabled": true,
    "universe_size": 10,
    "lookback_days": 7,
    "min_sentiment_score": -1.0,
    "schedule_day": "sun",
    "schedule_hour": 20,
    "schedule_minute": 0,
    "schedule_timezone": "America/New_York",
    "model_name": "AnkitAI/FinSense-ModernBERT-Financial-News-Sentiment-Analysis",
    "fallback_model": "AnkitAI/distilbert-base-uncased-financial-news-sentiment-analysis",
    "batch_size": 16,
    "cache_max_age_hours": 24
  }
}
