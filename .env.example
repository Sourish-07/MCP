# Robinhood MCP Trading Bot Environment Variables
# Copy this file to .env and fill in your actual values

# Anthropic API Key (for LLM calls)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Finnhub API Key (for news data)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Robinhood MCP Server URL
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# Trading Configuration
DRY_RUN=true

# Weekly Selector Configuration (optional overrides)
# SENTIMENT_SELECTION_ENABLED=true
# SENTIMENT_UNIVERSE_SIZE=10
# SENTIMENT_LOOKBACK_DAYS=7
# SENTIMENT_MIN_SCORE=-1.0
# SENTIMENT_SCHEDULE_DAY=sunday
# SENTIMENT_SCHEDULE_HOUR=20
# SENTIMENT_TIMEZONE=America/New_York

# Logging
LOG_LEVEL=INFO